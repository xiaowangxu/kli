{
	"name": "kli",
	"version": "1.0.0",
	"description": "A Solid JSX renderer for building reactive terminal user interfaces.",
	"keywords": [
		"terminal",
		"tui",
		"solid-js",
		"jsx",
		"yoga-layout"
	],
	"author": "",
	"license": "ISC",
	"type": "module",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"imports": {
		"#renderer": "./src/package/solid/render.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"run": "node .dev/dev.js",
		"dev": "tsup --watch --config tsup.config.dev.ts",
		"build": "tsup --config tsup.config.build.ts",
		"start": "tsup --config tsup.config.dev.ts && node .dev/dev.js",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/core.test.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"solid-js": "^1.8.0"
	},
	"devDependencies": {
		"@types/node": "^24.8.0",
		"esbuild-plugin-solid": "^0.6.0",
		"solid-js": "^1.9.9",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"yoga-layout": "^3.2.1"
	}
}
